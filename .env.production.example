# Copie para /dockerlabs/sell/.env no VPS e preencha.
# Sem aspas em valores simples: o env_file do Docker não é um parser de shell.

APP_NAME=Sell
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sell.areio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Banco de dados -------------------------------------------------
# Opção A (recomendada): MySQL já existente na rede shared-prod, com database/usuário PRÓPRIOS
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=sell
DB_USERNAME=sell
DB_PASSWORD=

# Opção B: SQLite persistido no volume de storage (comente o bloco acima)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/storage/database.sqlite
# --------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=sell.areio.com.br
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@areio.com.br
MAIL_FROM_NAME=Sell
